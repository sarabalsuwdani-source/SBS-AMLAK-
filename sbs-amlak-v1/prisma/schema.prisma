generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PropertyType {
  BUILDING
  WAREHOUSE
  STRIP_MALL
}

enum UnitStatus {
  VACANT
  RENTED
  MAINTENANCE
}

enum PaymentPlan {
  ONE
  TWO
  FOUR
  SIX
  MONTHLY
  CUSTOM
}

enum PaymentStatus {
  PAID
  PARTIAL
  LATE
  DUE_SOON
  NOT_DUE
}

enum Role {
  SUPER_ADMIN
  ADMIN
  ACCOUNTANT
  PROPERTY_SUPERVISOR
}
