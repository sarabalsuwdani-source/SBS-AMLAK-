generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum PropertyType {
  BUILDING
  WAREHOUSE
  STRIP_MALL
}

enum UnitStatus {
  VACANT
  RENTED
  MAINTENANCE
}

enum PaymentPlan {
  ONE
  TWO
  FOUR
  SIX
  MONTHLY
  CUSTOM
}

enum PaymentStatus {
  PAID
  PARTIAL
  LATE
  DUE_SOON
  NOT_DUE
}

enum Role {
  SUPER_ADMIN
  ADMIN
  ACCOUNTANT
  PROPERTY_SUPERVISOR
}

model User {
  id                 String     @id @default(cuid())
  username           String     @unique
  email              String?    @unique
  password           String
  role               Role       @default(ADMIN)
  mustChangePassword Boolean    @default(true)
  createdAt          DateTime   @default(now())
  auditLogs          AuditLog[]
}

model Property {
  id        String       @id @default(cuid())
  name      String
  code      String       @unique
  type      PropertyType
  owner     String?
  location  String?
  status    String       @default("نشط")
  notes     String?
  units     Unit[]
  createdAt DateTime     @default(now())
}

model Unit {
  id         String     @id @default(cuid())
  propertyId String
  property   Property   @relation(fields: [propertyId], references: [id])
  number     String
  type       String
  floor      String?
  area       Float?
  rentAmount Decimal?   @db.Decimal(12, 2)
  status     UnitStatus @default(VACANT)
  notes      String?
  contracts  Contract[]

  @@unique([propertyId, number])
}

model Tenant {
  id             String     @id @default(cuid())
  fullName       String
  phone          String
  identityNumber String?
  nationality    String?
  rating         String?
  notes          String?
  contracts      Contract[]
  createdAt      DateTime   @default(now())
}

model Contract {
  id          String       @id @default(cuid())
  contractNo  String       @unique
  tenantId    String
  tenant      Tenant       @relation(fields: [tenantId], references: [id])
  unitId      String
  unit        Unit         @relation(fields: [unitId], references: [id])
  startDate   DateTime
  endDate     DateTime
  annualRent  Decimal      @db.Decimal(12, 2)
  deposit     Decimal?     @db.Decimal(12, 2)
  paymentPlan PaymentPlan
  status      String       @default("نشط")
  payments    Payment[]
  attachments Attachment[]
  createdAt   DateTime     @default(now())
}

model Payment {
  id            String        @id @default(cuid())
  contractId    String
  contract      Contract      @relation(fields: [contractId], references: [id])
  installmentNo Int
  amountDue     Decimal       @db.Decimal(12, 2)
  amountPaid    Decimal       @default(0) @db.Decimal(12, 2)
  dueDate       DateTime
  paidAt        DateTime?
  status        PaymentStatus @default(NOT_DUE)
  reference     String?
  receiptUrl    String?
  createdAt     DateTime      @default(now())
}

model Attachment {
  id         String    @id @default(cuid())
  contractId String?
  contract   Contract? @relation(fields: [contractId], references: [id])
  fileName   String
  fileUrl    String
  type       String
  createdAt  DateTime  @default(now())
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  entity    String
  entityId  String?
  changes   Json?
  createdAt DateTime @default(now())
}
